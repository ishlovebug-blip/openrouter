{
  "version": 2,
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://openrouter.ai/api/v1/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://openrouter.ai/api/v1/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://openrouter.ai/:path*"
    }
  ]
}
